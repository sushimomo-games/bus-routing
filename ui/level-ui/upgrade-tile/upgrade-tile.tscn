[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/level-ui/upgrade-tile/UpgradeTile.cs" id="1_tile"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_tile"]
content_margin_left = 6.0
content_margin_top = 4.0
content_margin_right = 6.0
content_margin_bottom = 4.0
bg_color = Color(0.2, 0.2, 0.2, 0.9)

[node name="UpgradeTile" type="PanelContainer"]
custom_minimum_size = Vector2(80, 70)
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_tile")
script = ExtResource("1_tile")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="PriceLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "$0"

[node name="NameLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 6
text = "Upgrade"
horizontal_alignment = 1

[node name="CheckBox" type="CheckBox" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 8

[connection signal="toggled" from="VBoxContainer/CheckBox" to="." method="_on_check_box_toggled"]
